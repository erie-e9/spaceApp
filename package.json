{
  "name": "spaceapp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "lint": "eslint --fix . --c .js,.jsx,.ts,.tsx,",
    "start": "npx react-native start --reset-cache",
    "test": "jest",
    "type-check": "tsc",
    "test:report": "jest --collectCoverage --coverageDirectory=\"./coverage\" --ci --reporters=default --reporters=jest-junit --coverage",
    "pretty": "prettier --write \"./**/*.{js,jsx,json,ts,tsx}\"",
    "format": "prettier --write .",
    "depcheck": "depcheck",
    "prepare": "husky install",
    "debugger": "open 'rndebugger://set-debugger-loc?host=localhost&port=8081'",
    "androidbuild": "react-native run-android --variant=release --verbose",
    "run:a": "yarn react-native run-android --active-arch-only",
    "r:android": "rm -rf node_modules/ && rm -rf yarn.lock && yarn && cd android && ./gradlew clean && ./gradlew --stop && rm -rf android/app/build android/app/.cxx android/build && cd .. && npx react-native start --reset-cache",
    "r:ios": "rm -rf /Users/erictorresandrade/Caches/CocoaPods && rm -rf node_modules/ && rm -rf yarn.lock && yarn && cd ios && pod deintegrate && pod setup && pod cache clean --all && rm -rf Pods/ build/ Podfile.lock && bundle install && pod install && cd .. && npx react-native start --reset-cache",
    "reload": "yarn && npx pod-install && rm -rf android/app/build android/app/.cxx android/build && cd android && ./gradlew clean && ./gradlew --stop && cd ..",
    "aabi": "cd android && adb uninstall com.spaceapp && cd app && rm -rf .cxx && cd .. && ./gradlew clean && ./gradlew --stop && cd .. && npx react-native run-android --active-arch-only",
    "analyze:android": "yarn run react-native-bundle-visualizer --platform android --dev false --entry-file index.js --bundle-output ./android-release.bundle --sourcemap-output ./android-release.bundle.map --format json --reset-cache",
    "analyze:ios": "yarn run react-native-bundle-visualizer --platform ios --dev false --entry-file index.js --bundle-output ./ios-release.bundle --sourcemap-output ./ios-release.bundle.map --format json --reset-cache",
    "check-dependencies": "npx rnx-align-deps",
    "fix-dependencies": "npx rnx-align-deps --write"
  },
  "dependencies": {
    "@attarchi/react-native-lottie-splash-screen": "^2.0.4",
    "@bokuhe/react-native-check-app-install": "^0.1.0",
    "@d11/react-native-fast-image": "^8.9.2",
    "@invertase/react-native-apple-authentication": "^2.4.0",
    "@marianj97/react-native-biometrics": "^1.0.3",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-firebase/app": "^21.10.1",
    "@react-native-firebase/app-check": "^21.10.1",
    "@react-native-firebase/auth": "^21.10.1",
    "@react-native-firebase/remote-config": "^21.10.1",
    "@react-native-google-signin/google-signin": "^13.2.0",
